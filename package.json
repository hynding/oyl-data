{
  "name": "@oyl/data",
  "version": "0.1.0",
  "private": true,
  "description": "Seed data for OYL (Organize Your Life): nutrition reference tables, generic foods, and US branded products from Open Food Facts, as YAML + a compiled SQLite artifact.",
  "type": "module",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "extract:off": "tsx scripts/extract-off.ts",
    "shard:off": "tsx scripts/shard-products.ts",
    "validate": "tsx scripts/validate.ts",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "pnpm typecheck && pnpm validate && pnpm build",
    "test": "tsx scripts/shard-products.ts --in tests/fixtures/off-sample.jsonl --out .cache/test-products && tsx scripts/validate.ts --quick --dir .cache/test-products"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.6-r.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.2.0",
    "fast-glob": "^3.3.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.17.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
